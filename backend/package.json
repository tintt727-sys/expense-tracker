{
  "name": "expense-tracker-backend",
  "version": "1.0.0",
  "description": "Production REST API for Expense Tracker Pro",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
