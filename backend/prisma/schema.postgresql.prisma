// Prisma Schema for Expense Tracker Pro (PostgreSQL Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@map("users")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  type          String   // "income" | "expense"
  amount        Float
  description   String
  category      String
  date          String   // YYYY-MM-DD
  paymentMethod String   // "Cash" | "Bank" | "Card" | "Mobile Payment"
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([category])
  @@index([type])
  @@map("transactions")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String
  type      String   // "income" | "expense"
  createdAt DateTime @default(now())

  @@map("categories")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admins")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String   // "REGISTER" | "LOGIN" | "FORGOT_PASSWORD"
  payload   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("otp_verifications")
}
